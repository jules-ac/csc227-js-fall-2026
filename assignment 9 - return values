function problem_3() {
function beepersInLargerPile(k) {
  let leftCount = 0;
  let rightCount = 0;
  while (k.beepersPresent()) {
   k.pickBeeper();
   leftCount += 1; 
  }
  k.move();
  while (k.beepersPresent()) {
   k.pickBeeper();
   rightCount += 1; 
  }
  turnAround(k);
  k.move();
  turnAround(k);
  if (rightCount<leftCount) { return "left"; }
  else if (rightCount>leftCount) { return "right"; }
}

function markWinner(k, winner) {
  if (winner == "left") {
    k.paintCorner("Red");
  }
  else if (winner == "right") {
    k.move();
    k.paintCorner("Red");
  }

}

function turnRight(k) {
  k.turnLeft();
  k.turnLeft();
  k.turnLeft();
}

function turnAround(k) {
  k.turnLeft();
  k.turnLeft();
}

function main(k) {
  k.move();
  markWinner(k, beepersInLargerPile(k));

  for (let i = 0; i < 3; i++) k.move();
  k.turnLeft();
  k.move();
  k.move();
  turnRight(k);
  markWinner(k, beepersInLargerPile(k));

  k.turnLeft();
  k.move();
  k.move();
  k.turnLeft();
  for (let i = 0; i < 4; i++) k.move();
  turnRight(k);
  turnRight(k);
  markWinner(k, beepersInLargerPile(k));

  k.turnLeft();
  k.move();
  k.move();
  turnRight(k);
  for (let i = 0; i < 5; i++) k.move();
  markWinner(k, beepersInLargerPile(k));
}
  return main;
}

