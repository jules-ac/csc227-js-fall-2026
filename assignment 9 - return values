  let count = 0;
  for (let i=0;i<rows;i++) {
   while (k.frontIsClear()) {
    if (k.cornerColorIs("Green")) { count += 1; }
    k.move();
   }
   if (k.cornerColorIs("Green")) { count += 1; }
   if (i!=rows-1) { rotateAndAscend(k); }
  }
  return count;
}
