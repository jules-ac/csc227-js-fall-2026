function problem_4() {
function turnRight(k) {
  k.turnLeft();
  k.turnLeft();
  k.turnLeft()
}

function fixSquare(k) {
 if (k.cornerColorIs("Red")) {k.putBeeper()};
 if (k.cornerColorIs("Orange")) {k.putBeeper(); k.putBeeper()};
 if (k.cornerColorIs("Blue")) {k.putBeeper(); k.putBeeper(); k.putBeeper()} 
}

function walkFloor(k) {
  fixSquare(k);
  k.move();
  fixSquare(k);
  k.move();
  fixSquare(k);
  k.move();
  fixSquare(k);
  k.move();
  fixSquare(k);
  k.move();
  fixSquare(k);
  k.move();
  fixSquare(k);
  k.move();
  fixSquare(k);
}

function elevatorRight(k) {
 k.turnLeft();
 k.move();
 k.turnLeft() 
}

function elevatorLeft(k) {
 turnRight(k);
 k.move();
 turnRight(k)
}

function main(k) {
  walkFloor(k);
  elevatorRight(k);
  walkFloor(k);
