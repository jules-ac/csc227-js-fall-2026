// Problem 1: simple (Simple)
// ──────────────────────────────────────────────────────────
function problem_1() {
function moveToAve(k, ave) {
 for (let i=1;i<ave;i++) { k.move(); } 
}

function colorTiles(k, tiles, color) {
 for (let i=0;i<tiles;i++) {
   k.paintCorner(color);
   if (i!=tiles-1) { k.move(); }
 }
}

function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function turnAround(k) {
 k.turnLeft();
 k.turnLeft(); 
}

function resetToLeft(k) {
  turnAround(k);
  while (k.frontIsClear()) { k.move(); }
  turnRight(k);
  while (k.frontIsClear()) { k.move(); }
  turnAround(k);
}

function main(k) {
  
  let flags = [
    { avenue: 1, height: 2, color: "Red" },
    { avenue: 3, height: 4, color: "Blue" },
    { avenue: 4, height: 1, color: "Yellow" },
    { avenue: 6, height: 3, color: "Green" },
  ];
  
  for (let i=0;i<flags.length;i++) {
    moveToAve(k, flags[i].avenue);
    k.turnLeft();
    colorTiles(k, flags[i].height, flags[i].color);
    resetToLeft(k);
  }
  
}
  return main;
}

