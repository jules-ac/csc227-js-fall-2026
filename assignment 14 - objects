function problem_4() {
// Return the name of this corner's color.
function readColor(k) {
  let candidates = ["Red", "Orange", "Yellow", "Green", "Blue", "Cyan", "Magenta", "Pink"];
  for (let i = 0; i < candidates.length; i++) {
    if (k.cornerColorIs(candidates[i])) {
      return candidates[i];
    }
  }
  return "";
}

// Pick up the whole pile on this corner and return its size.
function takePile(k) {
  let n = 0;
  while (k.beepersPresent()) {
    k.pickBeeper();
    n++;
  }
  return n;
}

function turnAround(k) {
  k.turnLeft();
  k.turnLeft();
}

function selectionSort(k, origArr) {
 let newArr = [];
 
 while (origArr.length>0) {
  let minSize = origArr[0].size;
  let minColor = origArr[0].color;
  let minIndex = 0;
  for (let i=1;i<origArr.length;i++) {
    if (origArr[i].size<minSize) {
      minSize = origArr[i].size;
      minColor = origArr[i].color;
      minIndex = i;
    } 
  }
  origArr.splice(minIndex, 1);
  let minCorner = { size: minSize, color: minColor }
  newArr.push(minCorner);
 }
 return newArr;
}

function main(k) {
  let corners = [];
  
  while (k.frontIsClear()) {
    corner = { color: readColor(k), size: takePile(k) }
    corners.push(corner);
    k.move();
  }
  corner = { color: readColor(k), size: takePile(k) }
  corners.push(corner);
  
  turnAround(k);
  while (k.frontIsClear()) {
    k.move();
  }
  turnAround(k);
  
  let sortedCorners = selectionSort(k, corners);
  
  for (let i=0;i<sortedCorners.length;i++) {
   k.paintCorner(sortedCorners[i].color);
   for (let y=0;y<sortedCorners[i].size;y++) { k.putBeeper(); }
   if (k.frontIsClear()) { k.move(); } 
  }
  
}
  return main;
}
