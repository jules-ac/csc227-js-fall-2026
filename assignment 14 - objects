// Problem 3: complex (Complex)
// ──────────────────────────────────────────────────────────
function problem_3() {
function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function turnAround(k) {
 k.turnLeft();
 k.turnLeft(); 
}

function paintConditional(k, pos, rect) {
  if ( (( pos.row === rect.south || pos.row === rect.north ) && (pos.col >= rect.west && pos.col <= rect.east)) ||
  (( pos.col === rect.west || pos.col === rect.east ) && (pos.row >= rect.south && pos.row <= rect.north)) ) { k.paintCorner("Yellow"); }
}

function main(k) {
  
  let rect = {
    north: undefined,
    east: undefined,
    south: undefined,
    west: undefined
  }
  
  let pos = { row:1, col:1 }
  
  while (k.frontIsClear()) {
   while (k.frontIsClear()) {
     
    if (k.beepersPresent()) {
      if (rect.north===undefined) {
        rect.north=pos.row;
        rect.south=pos.row;
        rect.east=pos.col;
        rect.west=pos.col;
      }
      else {
      if (pos.col>rect.east) { rect.east = pos.col; }
      if (pos.col<rect.west) { rect.west = pos.col; }
      if (pos.row>rect.north) { rect.north = pos.row; }
      if (pos.row<rect.south) { rect.south = pos.row; }
     }
    }
    if (k.frontIsClear()) {
      k.move();
      pos.col++;
     }
   } 
    turnAround(k);
    while (k.frontIsClear()) { k.move(); }
    pos.col = 1;
    turnRight(k);
    if (k.frontIsClear()) {
     k.move();
     turnRight(k);
     pos.row++; 
    }
  }
  
  turnAround(k);
  while (k.frontIsClear()) { k.move(); }
  k.turnLeft();
  
  pos.row = 1;
  pos.col = 1;
  
  while (k.frontIsClear()) {
   while (k.frontIsClear()) {
    paintConditional(k, pos, rect);
    if (k.frontIsClear()) {
      k.move();
      pos.col++;
     } 
   } 
    paintConditional(k, pos, rect);
    turnAround(k);
    while (k.frontIsClear()) { k.move(); }
    pos.col = 1;
    turnRight(k);
    if (k.frontIsClear()) {
      k.move();
      turnRight(k);
      pos.row++;
    }
  }
}
  return main;
}

