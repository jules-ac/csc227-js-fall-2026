function problem_2() {
function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function turnAround(k) {
 k.turnLeft();
 k.turnLeft(); 
}

function resetToLeft(k) {
 turnAround(k);
 while (k.frontIsClear()) { k.move(); }
 turnRight(k);
 if (k.frontIsClear()) {
   k.move();
   turnRight(k);
 }
}

function main(k) {
  let best = { street: 0, total: -1 };
  let rowCt = 0;

for (let row=1;row<=5;row++) {
 rowCt = 0;
 for (let col=1;col<=5;col++) {
  replaceCt = 0;
  while (k.beepersPresent()) {
    k.pickBeeper();
    rowCt++;
    replaceCt++;
  }
  for (let i=0;i<replaceCt;i++) { k.putBeeper(); }
  if (k.frontIsClear()) { k.move(); }
