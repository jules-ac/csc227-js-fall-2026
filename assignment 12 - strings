function problem_4() {
function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function paintByCode(k, code) {
// using toLowerCase property on code produced this error - "Karel stopped early: can't access property "toLowerCase", code is undefined".
// which is weird because, it still did what it was supposed to do. it converted code to lowercase and the code ran correctly, but it still
// showed that error. so i handled this more primitively
 if (code === "r" || code === "R") { k.paintCorner("Red"); }
 else if (code === "g" || code === "G") { k.paintCorner("Green"); }
 else if (code === "b" || code === "B") { k.paintCorner("Blue"); }
 else if (code === "c" || code === "C") { k.paintCorner("Cyan"); }
 else if (code === "y" || code === "Y") { k.paintCorner("Yellow"); }
}

function slideLeft(k) {
  k.turnLeft();
  k.turnLeft();
  while (k.frontIsClear()) { k.move(); }
  turnRight(k);
  k.move();
  turnRight(k);
}

function main(k) {
  let plan = "RGBYC";

  for (let i=0;i<plan.length;i++) {
    paintByCode(k, plan[i]);
    if (k.frontIsClear()) { k.move(); }  
  }

  slideLeft(k);

  for (let i=plan.length-1;i>=0;i--) {
    paintByCode(k, plan[i]);
    if (k.frontIsClear()) { k.move(); }
  }
  
  slideLeft(k);
  
  for (let i=1;i<plan.length;i++) {
   paintByCode(k, plan[i]);
   if (k.frontIsClear()) { k.move(); }
  }
  paintByCode(k, plan[0]);
}
  return main;
}
