function problem_3() {
function interpretCmdPair(k, pair) {
  let cmd = pair[0].toLowerCase();
  let ct = pair[1];
  if (cmd=="m") {
   for (let i=0;i<ct;i++) { k.move(); } 
  }
  else if (cmd=="l") {
   for (let i=0;i<ct;i++) { k.turnLeft(); }
  }
}

function main(k) {
  let cmds = "m4l1M3L1m2";
  for (let i=0;i<cmds.length;i++) {
    let pair = cmds.slice(i,i+2);
    interpretCmdPair(k, pair);
  }
}
  return main;
}

