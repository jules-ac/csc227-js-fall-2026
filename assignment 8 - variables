function problem_2() {
function turnRight(k) {
 for (let i=0;i<3;i++) {
  k.turnLeft(); 
 } 
}
function turnAround(k) {
 for (let i=0;i<2;i++) {
  k.turnLeft();
 } 
}
function gatherBeepersFromRow(k) {
  let rowBeeperCount = 0;
  while (k.frontIsClear()) {
    while (k.beepersPresent()) {
       k.pickBeeper();
       rowBeeperCount += 1;
    }
   k.move(); 
  }
  while (k.beepersPresent()) {
    k.pickBeeper();
    rowBeeperCount += 1;
  }
  return rowBeeperCount;
}
function resetLeftAndDropBeepers(k, beeperCount) {
  turnAround(k);
  while (k.frontIsClear()) {
   k.move(); 
  }
  for (let i=0;i<beeperCount;i++) {
   k.putBeeper(); 
  }
}
function main(k) {
  while (k.frontIsClear()) {
    let rowBeeperCount = gatherBeepersFromRow(k);
    resetLeftAndDropBeepers(k, rowBeeperCount);
    turnRight(k);
    k.move();
    turnRight(k);
    if (!k.frontIsClear()) {
     return;
    }
    k.move();
  }

}
  return main;
}

