// Problem 2: moderate (Medium)
// ──────────────────────────────────────────────────────────
function problem_2() {
function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}
function turnAround(k) {
  k.turnLeft();
  k.turnLeft();
}
function gatherRowBeepers(k) {
  let beepers = 0;
  while (k.frontIsClear()) {
    while (k.beepersPresent()) {
       k.pickBeeper();
       beepers++;
    }
   k.move(); 
  }
  while (k.beepersPresent()) {
    k.pickBeeper();
    beepers++;
  }
  return beepers;
}
function resetLeftAndDropBeepers(k, beepers) {
  turnAround(k);
  while (k.frontIsClear()) { k.move(); }
  for (let i=0;i<beepers;i++) { k.putBeeper(); }
}
function main(k) {
  while (k.frontIsClear()) {
    let rowBeepers = gatherRowBeepers(k);
    resetLeftAndDropBeepers(k, rowBeepers);
    turnRight(k);
    if (!k.frontIsClear()) { return; }
    k.move();
    turnRight(k);
    }
    k.move();
  }
  return main;
}

