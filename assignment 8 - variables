// Problem 1: simple (Easy)
// ──────────────────────────────────────────────────────────
function problem_1() {
function main(k) {
  let count = 0;
  while (k.frontIsClear()) {
   k.putBeeper();
   k.move();
   count++;
  }
  k.turnLeft();
  k.putBeeper();
  for (let i=0;i<count;i++) {
   k.move();
   k.putBeeper(); 
  }
}
  return main;
}

