function problem_1() {
function main(k) {
  let heights = [2, 4, 1, 3, 2];
  let colors = ["Red", "Orange", "Yellow", "Green", "Blue"];
  
  for (let i=0;i<heights.length;i++) {
   k.turnLeft();
   for (let y=0;y<heights[i];y++) {
    k.paintCorner(colors[i]);
    if (y!=heights[i]-1) { k.move(); }
   } 
   k.turnLeft();
   k.turnLeft();
   while (k.frontIsClear()) { k.move(); }
   k.turnLeft();
   if (k.frontIsClear()) { k.move(); }
  }
}
  return main;
}

