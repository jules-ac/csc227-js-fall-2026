// Problem 1: simple (Simple)
// ──────────────────────────────────────────────────────────
function problem_1() {
function main(k) {
  let heights = [2, 4, 1, 3, 2];
  let colors = ["Red", "Orange", "Yellow", "Green", "Blue"];
  
  k.turnLeft();
  
  for (let i=0;i<colors.length;i++) {
    for (let y=0;y<heights[i];y++) {
     k.paintCorner(colors[i]);
     if (y!=heights[i]-1) { k.move(); } 
    }
    k.turnLeft();
    k.turnLeft();
    while (k.frontIsClear()) { k.move(); }
    k.turnLeft();
    if (k.frontIsClear()) {
      k.move();
      k.turnLeft();  
    }
  }
}
  return main;
}

// ──────────────────────────────────────────────────────────
// Problem 2: moderate (Moderate)
// ──────────────────────────────────────────────────────────
function problem_2() {
function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function turnAround(k) {
 k.turnLeft();
 k.turnLeft();
}

function main(k) {
  let totals = new Array(5).fill(0);
  
  for (let row=0;row<5;row++) {
    for (let col=0;col<5;col++) {
      while (k.beepersPresent()) {
       k.pickBeeper();
       totals[col]++; 
      }
      if (k.frontIsClear()) { k.move(); }
    }
    turnAround(k);
    while (k.frontIsClear()) { k.move(); }
    turnRight(k);
    if (k.frontIsClear()) { k.move(); }
    turnRight(k);
  }
  
  turnRight(k);
  while (k.frontIsClear()) { k.move(); }
  k.turnLeft();
  for (let step=0;step<5;step++) {
   for (let bpr=0;bpr<totals[step];bpr++) { k.putBeeper(); }
   if (k.frontIsClear()) { k.move(); }
  }
}
  return main;
}

