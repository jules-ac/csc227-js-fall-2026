// Problem 3: complex (Complex)
// ──────────────────────────────────────────────────────────
function problem_3() {
function turnAround(k) {
 k.turnLeft();
 k.turnLeft();
}

function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function pushTileToArr(k, arr) {
 let tilebprs = 0;
 while (k.beepersPresent()) {
  k.pickBeeper();
  tilebprs++; 
 }
 if (tilebprs!=0) { arr.push(tilebprs); }
}

function popTileFromArr(k, arr) {
  let tilebprs = arr.pop();
  for (let i=0;i<tilebprs;i++) { k.putBeeper(); }
}

function main(k) {
  
  while (k.frontIsClear()) {
    let lineWord = [];
  
    while (k.frontIsClear()) {
      pushTileToArr(k, lineWord);
      k.move();
    }
    pushTileToArr(k, lineWord);
  
    turnAround(k);
    
    while (k.frontIsClear()) {
      popTileFromArr(k, lineWord);
      k.move();
    }
    popTileFromArr(k, lineWord);
  
    turnRight(k);
    if (k.frontIsClear()) {
      k.move();
      turnRight(k);
    }
  }
}
  return main;
}

