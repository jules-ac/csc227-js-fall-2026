// Problem 4: complex2 (Complex II)
// ──────────────────────────────────────────────────────────
function problem_4() {
function turnAround(k) {
 k.turnLeft();
 k.turnLeft();
}

function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function pushTileToArr(k, arr) {
 let tilebprs = 0;
 while (k.beepersPresent()) {
  k.pickBeeper();
  tilebprs++; 
 }
 arr.push(tilebprs);
}

function main(k) {
  let grid = [];
  
  while (k.frontIsClear()) { 
   let line = [];
   
   while (k.frontIsClear()) {
    pushTileToArr(k, line);
    k.move();
   }
   pushTileToArr(k, line);
  
   grid.push(line);
   
   turnAround(k);
   while (k.frontIsClear()) { k.move(); }
   turnRight(k);
   if (k.frontIsClear()) {
    k.move();
    turnRight(k); 
   }
  }
  
  turnAround(k);
  while (k.frontIsClear()) { k.move(); }
  k.turnLeft();
  
  for (let r=0;r<grid.length;r++) {
   for (let c=0;c<grid.length;c++) {
    let tilebprs = grid[c][grid.length-1-r];
    for (let i=0;i<tilebprs;i++) { k.putBeeper(); }
     if (k.frontIsClear()) { k.move(); }
   } 
   if (!k.frontIsClear()) {
    turnAround(k);
    while (k.frontIsClear()) { k.move(); }
    turnRight(k);
    if (k.frontIsClear()) { k.move(); }
    turnRight(k); 
   }
  }
}
  return main;
}
