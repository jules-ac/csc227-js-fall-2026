// Problem 1: simple (Simple)
// ──────────────────────────────────────────────────────────
function problem_1() {
function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function countBeepersOverThreeTiles(k) {
 let ct = 0;
 for (let i=0;i<3;i++) {
   if (k.beepersPresent()) { ct++; }
   k.move();
 }
 return ct; 
}

function placeBeepersByCount(k, ct) {
 for (let i=0;i<ct;i++) {
  k.putBeeper();
  k.move(); 
 } 
}

function main(k) {
  let leftCt = 0;
  let rightCt = 0;
  
  for (let i=0;i<4;i++) {
   leftCt = countBeepersOverThreeTiles(k);
   k.move();
   rightCt = countBeepersOverThreeTiles(k);
   k.move();
   placeBeepersByCount(k, leftCt+rightCt);
   k.turnLeft();
   k.turnLeft();
   while (k.frontIsClear()) { k.move(); }
   if (i!=3) {
     turnRight(k);
     k.move();
     turnRight(k); 
   } 
  }
}
  return main;
}

// ──────────────────────────────────────────────────────────
// Problem 2: moderate (Moderate)
// ──────────────────────────────────────────────────────────
function problem_2() {
function main(k) {
  let beepersHeld = 17;
  let beepersPerTile = 5;
  let fillableBoxes = Math.floor(beepersHeld/beepersPerTile);
  
  for (let i=0;i<=fillableBoxes;i++) {
    if (beepersHeld>=beepersPerTile) {
     for (let i=0;i<beepersPerTile;i++) { k.putBeeper(); } 
     beepersHeld -= beepersPerTile;
    }
    else {
     for (let i=0;i<beepersHeld%beepersPerTile;i++) { k.putBeeper(); } 
    }
    k.move();
  }
}
  return main;
}

// ──────────────────────────────────────────────────────────
// Problem 3: complex (Complex)
// ──────────────────────────────────────────────────────────
function problem_3() {
function turnRight(k) {
 for (let i=0;i<3;i++) { k.turnLeft(); } 
}

function slideLeftAndFaceNorth(k) {
  k.turnLeft();
  k.turnLeft();
  while (k.frontIsClear()) { k.move(); }
  turnRight(k);
}

function main(k) {
  let avenue = 1;
  let street = 1;
  
  for (let i=0;i<6;i++) {
    for (let i=0;i<7;i++) {
       for (let i=0;i<(avenue*street)%5;i++) { k.putBeeper(); }
       if (k.frontIsClear()) {
         k.move();
         avenue++;
       }
    }
    
    slideLeftAndFaceNorth(k);
    
    if (k.frontIsClear()) {
      k.move();
      street++;
      avenue = 1;
      turnRight(k);
    }
  }
}
  return main;
}
