// Problem 1: simple (Simple)
// ──────────────────────────────────────────────────────────
function problem_1() {
function turnRight(k) {
 k.turnLeft();
 k.turnLeft();
 k.turnLeft() 
}
function putOrPick(k) {
  if (k.beepersPresent()) { k.pickBeeper() }
  else { k.putBeeper() } 
}
function traverse(k) {
  k.move();
  k.move();
  putOrPick(k)
}
function main(k) {
  traverse(k);
  turnRight(k);
  traverse(k)
}
  return main;
}

