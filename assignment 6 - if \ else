// ──────────────────────────────────────────────────────────
// Problem 3: complex (Complex)
// ──────────────────────────────────────────────────────────
function problem_3() {
function turnRight(k) {
 k.turnLeft(); 
 k.turnLeft();
 k.turnLeft();
}
function recolor(k) {
  if (k.noBeepersPresent()) { k.paintCorner("Red") } else { k.paintCorner("Blue") }
}
function rotate(k) {
    if (k.facingEast()) {
    k.turnLeft();
    k.move();
    k.turnLeft()
  } else {
    turnRight(k);
    k.move();
    turnRight(k) 
  } 
  recolor(k);
}
function paintSquare(k) {
  k.move();
  recolor(k);
}
function paintFloor(k) {
  for (let e=0;e<4;e++) { paintSquare(k); }
}
function main(k) {
  recolor(k);
  for (let i=0;i<3;i++) {
   paintFloor(k)
   rotate(k);
   }
  paintFloor(k)
}
  return main;
}

// ──────────────────────────────────────────────────────────
// Problem 4: advanced (Advanced)
// ──────────────────────────────────────────────────────────
function problem_4() {
function turnRight(k) {
  k.turnLeft();
  k.turnLeft();
  k.turnLeft()
}

function rotate(k) {
  if (k.facingEast()) { 
    k.turnLeft(); 
    k.move(); 
    k.turnLeft();
  }
  else { 
    turnRight(k); 
    k.move(); 
    turnRight(k);
  }
}

function fixSquare(k) {
   if (k.beepersPresent()) { return; }
   else if (k.cornerColorIs("Red")) { 
     for (let i=0;i<4;i++) { 
       k.putBeeper(); 
       } 
     }
   else if (k.cornerColorIs("Green")) { 
     for (let i=0;i<2;i++) { 
       k.putBeeper(); 
       } 
     } 
   else if (k.cornerColorIs("Blue")) {  
     k.putBeeper(); 
     }
}
function paintFloor(k) {
  for (let i=0;i<5;i++) {
    fixSquare(k);
    k.move()
  }
  fixSquare(k)
}

function main(k) {
  for (let i=0;i<3;i++) {
    paintFloor(k);
    rotate(k)
  }
  paintFloor(k)
 }
  return main;
}
