// Problem 3: complex (Complex)
// ──────────────────────────────────────────────────────────
function problem_3() {
function turnRight(k) {
 k.turnLeft(); 
 k.turnLeft();
 k.turnLeft();
}
function recolorTile(k) {
  if (k.noBeepersPresent()) { k.paintCorner("Red"); } else { k.paintCorner("Blue"); }
}
function rotateAndAscend(k) {
    if (k.facingEast()) {
    k.turnLeft();
    k.move();
    k.turnLeft();
  } else {
    turnRight(k);
    k.move();
    turnRight(k); 
  } 
}
function recolorFullFloor(k) {
  for (let e=0;e<4;e++) { 
    k.move();
    recolorTile(k); 
    }
}
function main(k) {
  recolorTile(k);
  for (let i=0;i<3;i++) {
   recolorFullFloor(k);
   rotateAndAscend(k);
   recolorTile(k);
   }
  recolorFullFloor(k);
}
  return main;
}

// ──────────────────────────────────────────────────────────
// Problem 4: advanced (Advanced)
// ──────────────────────────────────────────────────────────
function problem_4() {
function turnRight(k) {
  k.turnLeft();
  k.turnLeft();
  k.turnLeft();
}

function rotate(k) {
  if (k.facingEast()) { 
    k.turnLeft(); 
    k.move(); 
    k.turnLeft();
  }
  else { 
    turnRight(k); 
    k.move(); 
    turnRight(k);
  }
}

function recolorTile(k) {
   if (k.beepersPresent()) { return; }
   else if (k.cornerColorIs("Red")) { 
     for (let i=0;i<4;i++) { 
       k.putBeeper(); 
       } 
     }
   else if (k.cornerColorIs("Green")) { 
     for (let i=0;i<2;i++) { 
       k.putBeeper(); 
       } 
     } 
   else if (k.cornerColorIs("Blue")) {  
     k.putBeeper(); 
     }
}
function recolorFullFloor(k) {
  for (let i=0;i<5;i++) {
    recolorTile(k);
    k.move();
  }
  recolorTile(k);
}

function main(k) {
  for (let i=0;i<3;i++) {
    recolorFullFloor(k);
    rotate(k);
  }
  recolorFullFloor(k);
 }
  return main;
}
