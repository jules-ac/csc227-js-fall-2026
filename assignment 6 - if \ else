// Problem 1: simple (Simple)
// ──────────────────────────────────────────────────────────
function problem_1() {
function turnRight(k) {
 k.turnLeft();
 k.turnLeft();
 k.turnLeft();
}
function walkThenDecide(k) {
  k.move();
  k.move();
  if (k.beepersPresent()) { k.pickBeeper(); }
  else { k.putBeeper(); } 
}
function main(k) {
  walkThenDecide(k);
  turnRight(k);
  walkThenDecide(k);
}
  return main;
}

