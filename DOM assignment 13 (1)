// Status message (10 pts) — passed in browser
function setStatus(text, ok) {
  let status = document.getElementById("status");
  status.textContent = text;
  if (ok) {
    if (status.classList.contains("error")) { status.classList.remove("error"); }
    status.classList.add("ok");
  } else {
    if (status.classList.contains("ok")) { status.classList.remove("ok"); }
    status.classList.add("error");
  }
}
// ===== end problem 1 =====

// ===== problem 2: moderate =====
// Highlighter (10 pts) — passed in browser
function highlight(selector, cls) {
 
 let matched=0;
 let elements=document.querySelectorAll(selector);
 
 for (const element of elements) {
   element.classList.add(cls);
   matched++;
 }
 return matched;
 }

function clearHighlight(cls) {
  
  let matched=0;
  let elements=document.querySelectorAll("."+cls);
  for (const element of elements) {
    element.classList.remove(cls);
    matched++; 
  }
  return matched;
}
// ===== end problem 2 =====

