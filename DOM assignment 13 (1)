// ===== problem 1: simple =====
// Status message (10 pts) — passed in browser
function setStatus(text, ok) {
  let status = document.getElementById("status");
  status.textContent = text;
  if (ok) {
    if (status.classList.contains("error")) { status.classList.remove("error"); }
    status.classList.add("ok");
  } else {
    if (status.classList.contains("ok")) { status.classList.remove("ok"); }
    status.classList.add("error");
  }
}
// ===== end problem 1 =====

// ===== problem 2: moderate =====
// Highlighter (10 pts) — passed in browser
function highlight(selector, cls) {
 
 let matched=0;
 let elements=document.querySelectorAll(selector);
 
 for (const element of elements) {
   element.classList.add(cls);
   matched++;
 }
 return matched;
 }

function clearHighlight(cls) {
  
  let matched=0;
  let elements=document.querySelectorAll("."+cls);
  for (const element of elements) {
    element.classList.remove(cls);
    matched++; 
  }
  return matched;
}
// ===== end problem 2 =====

// ===== problem 3: complex =====
// Read and validate an order form (10 pts) — passed in browser
function readOrder() {
  let form = document.querySelector("#order");
  let elements = form.elements;

  let errorsArr  = [];
  
  let name = elements.name.value.trim();
  let address = elements.address.value.trim();
  let size = elements.size.value;
  let crust = elements.crust.value;
  let selectedToppings = form.querySelectorAll("input[name='topping']:checked");
  let toppings = [];
  for (let i=0;i<selectedToppings.length;i++) { toppings.push(selectedToppings[i].value); }
  let delivery = elements.delivery.checked;
  
  if (!name) { errorsArr.push("name is required"); }
  if (toppings.length===0) { errorsArr.push("choose at least one topping"); }
  if (delivery && !address) { errorsArr.push("address is required for delivery"); }
  
  let errors = document.getElementById("errors");
  errors.innerHTML = "";
  for (const err of errorsArr) {
   errors.insertAdjacentHTML("beforeend", "<li>"+err+"</li>"); 
  }
  
  return {
   name, size, crust, toppings, delivery, address, errors: errorsArr 
  };
  
}
// ===== end problem 3 =====

// ===== problem 4: challenge =====
// Price table from data attributes (10 pts) — passed in browser
function updateTotals(taxRate) {
  let metricsLine = document.querySelector("p");
  let cartBody = document.querySelector("tbody");
  
  let displayLines = cartBody.querySelectorAll(".line");
  let rows = cartBody.querySelectorAll("tr");
  
  let subtotal = 0;
  for (let i=0;i<rows.length;i++) {
   
   let lineTotal = Math.round((rows[i].dataset.price * rows[i].dataset.qty)*100)/100;
   subtotal += lineTotal;
   
   displayLines[i].textContent = "$"+lineTotal.toFixed(2);
   rows[i].dataset.line = lineTotal.toFixed(2);
   
   if (lineTotal>=10) { 
    if (!rows[i].classList.contains("big")) { rows[i].classList.add("big"); }
   }
   else {
      if (rows[i].classList.contains("big")) { rows[i].classList.remove("big"); }
   }
  }
  
  let tax = Math.round((subtotal*taxRate)*100)/100;
  let total = Math.round((subtotal+tax)*100)/100;
  
  metricsLine.querySelector("#subtotal").textContent = "$"+subtotal.toFixed(2);
  metricsLine.querySelector("#tax").textContent = "$"+tax.toFixed(2);
  metricsLine.querySelector("#total").textContent = "$"+total.toFixed(2);
  
  return total;
}
// ===== end problem 4 =====
