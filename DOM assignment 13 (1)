// Read and validate an order form (10 pts)
function readOrder() {
  let orderForm = document.getElementById("order").elements;
  
  let toppingsArr = [];
  for (const topping of orderForm.getElementsByName("topping")) {
    toppingsArr.push(topping.value);
  }
  
  
  return {
   name: orderForm.name.value.trim();
   size: orderForm.size.value;
   crust: orderForm.crust.value;
   toppings: orderForm.querySelectorAll("input[name=topping]:checked");
   delivery: orderForm.delivery.value;
   address: orderForm.address.value;
   errors: [
    nameErr:
    toppingErr:
    addressErr:
   ]
  }
}
